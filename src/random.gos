use std::sync

const GAMMA: u64 = 0x9e37_79b9_7f4a_7c15
const TWO_POW_53: f64 = 9007199254740992.0

/// SplitMix64 generator safe to share across concurrent requests. Its state is
/// one atomic counter and every draw claims its own step with a single
/// `fetch_add`, so no two callers observe the same state. Copies share it.
pub struct Random { state: sync::AtomicU64 }

impl Random {
    /// Generator whose sequence is fixed by `seed`.
    pub fn seeded(seed: u64) -> Random {
        Random { state: sync::AtomicU64::new(seed) }
    }

    /// Next 64 uniformly distributed bits.
    pub fn next_u64(&self) -> u64 {
        let previous = self.state.fetch_add(GAMMA)
        let mut z = previous +% GAMMA
        z = (z ^ (z >> 30)) *% 0xbf58_476d_1ce4_e5b9
        z = (z ^ (z >> 27)) *% 0x94d0_49bb_1331_11eb
        z ^ (z >> 31)
    }

    /// Uniform `f64` in `[0.0, 1.0)`.
    pub fn next_f64(&self) -> f64 {
        (self.next_u64() >> 11) as f64 / TWO_POW_53
    }

    /// Uniform `f64` in `[low, high]`; answers `low` when the range is empty.
    pub fn between(&self, low: f64, high: f64) -> f64 {
        if high <= low {
            return low
        }
        low + self.next_f64() * (high - low)
    }
}

#[cfg(test)]
mod tests {
    use super::Random

    #[test]
    fn same_seed_replays_the_same_sequence() {
        let a = Random::seeded(42)
        let b = Random::seeded(42)
        for _ in 0..16 {
            assert_eq(a.next_u64(), b.next_u64())
        }
    }

    #[test]
    fn different_seeds_diverge() {
        let a = Random::seeded(1)
        let b = Random::seeded(2)
        assert(a.next_u64() != b.next_u64())
    }

    #[test]
    fn next_f64_stays_in_unit_interval() {
        let r = Random::seeded(7)
        for _ in 0..1000 {
            let v = r.next_f64()
            assert(v >= 0.0 && v < 1.0, format("{} outside [0, 1)", v))
        }
    }

    #[test]
    fn between_stays_in_range() {
        let r = Random::seeded(9)
        for _ in 0..1000 {
            let v = r.between(10.0, 20.0)
            assert(v >= 10.0 && v <= 20.0, format("{} outside [10, 20]", v))
        }
    }

    #[test]
    fn between_answers_low_for_empty_range() {
        let r = Random::seeded(3)
        assert_eq(r.between(5.0, 5.0), 5.0)
        assert_eq(r.between(8.0, 2.0), 8.0)
    }

    #[test]
    fn copies_share_one_sequence() {
        let a = Random::seeded(11)
        let b = a
        let first = a.next_u64()
        let replay = Random::seeded(11)
        assert_eq(replay.next_u64(), first)
        assert(b.next_u64() != first, "a copy continues the shared sequence")
    }
}
