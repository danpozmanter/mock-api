use std::encoding::json
use std::http::router
use std::{errors, http, time}

use apispec::ApiSpec
use config::{json_body, normalize_path, Config, ErrorResponse, JsonBody}
use random::Random
use simulator::ErrorSimulator

const STREAM_CHUNKS: i64 = 3

// One registered (method, path) pair. Routes for the same path share one
// simulator, so every method on a path counts toward the same error rate.
struct Route { method: String, path: String, simulator: ErrorSimulator }

/// Routing table plus the state every request reads.
pub struct App {
    responses: Map<String, JsonBody>
    error_response: ErrorResponse
    table: router::Router
    routes: Vec<Route>
    methods: Vec<String>
    pacer: Pacer
}

/// Source of simulated latency. It holds only scalars and a shared generator,
/// so a stream-writer goroutine can carry it where it cannot carry an `App`.
pub struct Pacer { low: f64, high: f64, rng: Random }

/// What a request resolves to: a complete JSON body, or SSE chunks for `feed`.
pub enum Reply {
    Json { status: i64, body: String }
    Stream { chunks: Vec<String> }
}

impl App {
    /// Registers a route per (path, method) the spec declares, under the config's prefix.
    pub fn new(config: Config, spec: ApiSpec, rng: Random) -> Result<App, errors::Error> {
        let table = router::Router::new()
        let mut routes = #[]
        let mut methods = #[]
        for item in spec.paths {
            let full = build_full_path(config.prefix, item.path)
            let simulator = ErrorSimulator::new(config.error_response.frequency, rng)
            for method in item.methods {
                if let Err(e) = router::add(table, method, full) {
                    return Err(errors::new(format("registering {} {}: {}", method, full, e)))
                }
                routes.push(Route { method: method, path: full, simulator: simulator })
                if !methods.contains(method) {
                    methods.push(method)
                }
            }
        }
        let pacer = Pacer { low: config.latency.low, high: config.latency.high, rng: rng }
        Ok(App {
            responses: config.responses
            error_response: config.error_response
            table: table
            routes: routes
            methods: methods
            pacer: pacer
        })
    }

    /// Registered (method, path) pairs, in registration order.
    pub fn endpoints(&self) -> Vec<(String, String)> {
        self.routes.map(|r| (r.method, r.path))
    }

    /// Sleeps the simulated latency, then answers the override, default, or
    /// simulated error for a request; unknown paths and methods answer at once.
    pub fn respond(&self, method: String, path: String, query: Vec<(String, String)>) -> Reply {
        let Some(index) = router::lookup(self.table, method, path) else {
            if self.methods.iter().any(|m| router::lookup(self.table, m, path).is_some()) {
                println("405 {} {}", method, path)
                return json_error(405, "Method not allowed")
            }
            println("404 {} {}", method, path)
            return json_error(404, "Not found")
        }
        let route = self.routes[index]
        let latency = self.pacer.delay_ms()
        println("Path {}: Sleeping for {:.2} ms", route.path, latency)
        time::sleep(latency as i64)

        if route.simulator.should_error() {
            println("Simulating error for request")
            return Reply::Json {
                status: self.error_response.code
                body: self.error_response.body.compact
            }
        }
        let data = response_data(route.path, self.responses)
        if is_streaming(query) {
            Reply::Stream { chunks: split_chunks(data.compact, STREAM_CHUNKS) }
        } else {
            Reply::Json { status: 200, body: data.line }
        }
    }
}

impl Pacer {
    /// Uniform-random latency in the configured range, in milliseconds.
    pub fn delay_ms(&self) -> f64 {
        self.rng.between(self.low, self.high)
    }

    /// Writes each chunk as an SSE `data:` frame with a simulated latency after
    /// it, then the `[DONE]` marker; stops early once the client disconnects.
    pub fn feed(&self, body: http::ResponseStream, chunks: Vec<String>) {
        defer body.close()
        for chunk in chunks {
            if body.write(format("data: {}\n\n", chunk)) < 0 {
                return
            }
            time::sleep(self.delay_ms() as i64)
        }
        let _ = body.write("data: [DONE]\n\n")
    }
}

/// Serves `app` on a listening `server` until it shuts down. The server's
/// cohort owns every stream writer, so a writer keeps going after its handler
/// has returned the response head, and none outlives the server.
pub fn serve(app: App, server: http::Server) -> Result<(), errors::Error> {
    let pacer = app.pacer
    cohort {
        server.serve(|r| {
            match app.respond(r.method, r.path, r.query_pairs) {
                Reply::Json { status, body } => Ok(http::Response::json(status, body))
                Reply::Stream { chunks } => {
                    let body = http::ResponseStream::new()
                    spawn(|| pacer.feed(body, chunks))
                    Ok(http::Response::stream(200, "text/event-stream", body))
                }
            }
        })?
    }
}

/// Route path for a spec path under `prefix`, with exactly one `/` between them.
pub fn build_full_path(prefix: String, path: String) -> String {
    format("/{}/{}", prefix.trim_matches('/'), path.trim_start_matches('/'))
}

/// Override body configured for `path`, else `{"message": "Response for <path>"}`.
pub fn response_data(path: String, responses: Map<String, JsonBody>) -> JsonBody {
    let normalized = normalize_path(path)
    if let Some(body) = responses.get(normalized) {
        return body
    }
    single_field("message", format("Response for {}", normalized))
}

/// Whether the query asks for an SSE stream (`stream=true`, first value wins).
pub fn is_streaming(query: Vec<(String, String)>) -> bool {
    query.iter().find(|(k, _)| k == "stream").map(|(_, v)| v == "true").unwrap_or(false)
}

/// `text` split into `count` roughly equal pieces on character boundaries,
/// plus one shorter trailing piece when the length does not divide evenly.
pub fn split_chunks(text: String, count: i64) -> Vec<String> {
    let size = max(text.len() / count, 1)
    let mut chunks = #[]
    let mut current = String::with_capacity(size)
    let mut filled = 0
    for c in text {
        current.push(c)
        filled += 1
        if filled == size {
            chunks.push(current)
            current = String::with_capacity(size)
            filled = 0
        }
    }
    if filled > 0 {
        chunks.push(current)
    }
    chunks
}

/// `{"error": message}` as a JSON reply with `status`.
pub fn json_error(status: i64, message: String) -> Reply {
    Reply::Json { status: status, body: single_field("error", message).line }
}

// `{key: value}` for a `key` that needs no JSON escaping.
fn single_field(key: String, value: String) -> JsonBody {
    let text = format("{{\"{}\":{}}}", key, json::encode(value))
    // SAFETY: `json::encode` of a String answers a quoted JSON string literal,
    // so `text` is a well-formed object.
    json_body(json::parse(text).unwrap())
}

#[cfg(test)]
mod tests {
    use std::encoding::json
    use std::{errors, http, time}

    use apispec::parse_api_spec
    use config::parse_config
    use random::Random

    use super::{build_full_path, is_streaming, response_data, serve, split_chunks, App, Reply}

    fn app_with(frequency: f64) -> Result<App, errors::Error> {
        let cfg = parse_config(format("""
        api_spec: spec.yaml
        latency: {{ low: 10, high: 20 }}
        prefix: v1
        responses:
          /v1/test: '{{"custom":"data","value":123}}'
          /v1/struct:
            status: success
            code: 200
        error_response:
          code: 500
          body: {{ error: simulated error }}
          frequency: {}
        """, frequency))?
        let spec = parse_api_spec("""
        paths:
          /test: { get: {} }
          /struct: { get: {}, post: {} }
          /other: { get: {} }
          /models/{model}: { get: {} }
        """)?
        App::new(cfg, spec, Random::seeded(17))
    }

    fn json_reply(reply: Reply) -> (i64, json::Value) {
        match reply {
            Reply::Json { status, body } => (status, json::parse(body).unwrap())
            Reply::Stream { .. } => panic("expected a JSON reply")
        }
    }

    fn field(v: json::Value, key: String) -> String {
        json::render(json::get(v, key).unwrap())
    }

    #[test]
    fn string_override_is_returned() -> Result<(), errors::Error> {
        let app = app_with(0.0)?
        let status, body = json_reply(app.respond("GET", "/v1/test", #[("stream", "false")]))
        assert_eq(status, 200)
        assert_eq(field(body, "custom"), "\"data\"")
        assert_eq(field(body, "value"), "123")
        Ok(())
    }

    #[test]
    fn structured_override_is_returned() -> Result<(), errors::Error> {
        let app = app_with(0.0)?
        let status, body = json_reply(app.respond("POST", "/v1/struct", #[]))
        assert_eq(status, 200)
        assert_eq(field(body, "status"), "\"success\"")
        assert_eq(field(body, "code"), "200")
        Ok(())
    }

    #[test]
    fn route_without_override_answers_default_message() -> Result<(), errors::Error> {
        let app = app_with(0.0)?
        let status, body = json_reply(app.respond("GET", "/v1/other", #[]))
        assert_eq(status, 200)
        assert_eq(field(body, "message"), "\"Response for /v1/other\"")
        Ok(())
    }

    #[test]
    fn templated_path_matches_and_names_its_template() -> Result<(), errors::Error> {
        let app = app_with(0.0)?
        let status, body = json_reply(app.respond("GET", "/v1/models/gpt-4", #[]))
        assert_eq(status, 200)
        assert_eq(field(body, "message"), "\"Response for /v1/models/{model}\"")
        Ok(())
    }

    #[test]
    fn trailing_slash_matches_the_route() -> Result<(), errors::Error> {
        let app = app_with(0.0)?
        let status, _ = json_reply(app.respond("GET", "/v1/test/", #[]))
        assert_eq(status, 200)
        Ok(())
    }

    #[test]
    fn simulated_error_returns_configured_response() -> Result<(), errors::Error> {
        let app = app_with(1.0)?
        let status, body = json_reply(app.respond("GET", "/v1/test", #[]))
        assert_eq(status, 500)
        assert_eq(field(body, "error"), "\"simulated error\"")
        Ok(())
    }

    #[test]
    fn unknown_path_is_not_found() -> Result<(), errors::Error> {
        let app = app_with(0.0)?
        let status, body = json_reply(app.respond("GET", "/v1/unknown", #[]))
        assert_eq(status, 404)
        assert_eq(field(body, "error"), "\"Not found\"")
        Ok(())
    }

    #[test]
    fn undeclared_method_is_not_allowed() -> Result<(), errors::Error> {
        let app = app_with(0.0)?
        let status, body = json_reply(app.respond("DELETE", "/v1/test", #[]))
        assert_eq(status, 405)
        assert_eq(field(body, "error"), "\"Method not allowed\"")
        Ok(())
    }

    #[test]
    fn endpoints_list_every_route() -> Result<(), errors::Error> {
        let app = app_with(0.0)?
        assert_eq(app.endpoints(), #[
            ("GET", "/v1/models/{model}")
            ("GET", "/v1/other")
            ("GET", "/v1/struct")
            ("POST", "/v1/struct")
            ("GET", "/v1/test")
        ])
        Ok(())
    }

    #[test]
    fn stream_request_chunks_the_body() -> Result<(), errors::Error> {
        let app = app_with(0.0)?
        let Reply::Stream { chunks } = app.respond("GET", "/v1/test", #[("stream", "true")]) else {
            panic("expected a stream reply")
        }
        assert_eq(chunks.join(""), "{\"custom\":\"data\",\"value\":123}")
        Ok(())
    }

    #[test]
    fn server_answers_json_errors_and_sse_streams() -> Result<(), errors::Error> {
        let app = app_with(0.0)?
        let server = http::Server::new()
        server.listen("127.0.0.1:0")?
        let base = format("http://{}", server.addr())
        let mut statuses = #[]
        let mut frames = #[]
        let mut elapsed = #[]
        cohort {
            spawn(|| {
                defer server.shutdown(2000)
                for path in ["/v1/unknown", "/v1/test"] {
                    if let Ok(resp) = http::get(base + path, #[]) {
                        statuses.push(resp.status)
                    }
                }
                let start = time::Instant::now()
                if let Ok(stream) = http::stream("GET", base + "/v1/test?stream=true", "", #[]) {
                    while let Some(line) = stream.next_line() {
                        if !line.is_empty() {
                            frames.push(line)
                        }
                    }
                }
                elapsed.push(start.elapsed().as_millis())
            })
            serve(app, server)?
        }?
        assert_eq(statuses, #[404, 200])
        assert(frames.len() >= 4, format("frames: {:?}", frames))
        assert(frames.iter().all(|f| f.starts_with("data: ")), format("frames: {:?}", frames))
        assert_eq(frames[frames.len() - 1], "data: [DONE]")
        assert(elapsed[0] < 2000, format("stream took {} ms", elapsed[0]))
        Ok(())
    }

    #[test]
    fn build_full_path_joins_with_one_slash() {
        assert_eq(build_full_path("v1", "/models"), "/v1/models")
        assert_eq(build_full_path("/v1/", "models"), "/v1/models")
        assert_eq(build_full_path("api/v2", "/a/{id}"), "/api/v2/a/{id}")
    }

    #[test]
    fn response_data_escapes_the_default_message() {
        let data = response_data("/v1/\"q\"", Map::new())
        assert_eq(data.compact, "{\"message\":\"Response for /v1/\\\"q\\\"\"}")
    }

    #[test]
    fn is_streaming_reads_the_first_stream_value() {
        assert(is_streaming(#[("stream", "true")]))
        assert(!is_streaming(#[("stream", "false"), ("stream", "true")]))
        assert(!is_streaming(#[]))
    }

    #[test]
    fn split_chunks_covers_the_whole_text() {
        let chunks = split_chunks("abcdefghij", 3)
        assert_eq(chunks, #["abc", "def", "ghi", "j"])
        assert_eq(split_chunks("ab", 3), #["a", "b"])
        assert_eq(split_chunks("héllo wörld", 3).join(""), "héllo wörld")
    }
}
