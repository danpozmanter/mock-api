/// HTTP request handling. Pure functions for path matching,
/// override lookup, latency selection, and SSE body shaping.
/// The actual `App` / `http::Handler` impl lives in
/// `src/main.gos` so this module stays self-testing.
///
/// Embeds its own minimal LCG PRNG state for `get_latency_ms`
/// — cross-module method dispatch is currently broken in the
/// Gossamer interpreter, so every module that needs randomness
/// keeps a local copy. See `src/random/mod.gos` for the
/// canonical implementation.

use std::encoding::json
use std::http

// ─── Path helpers ──────────────────────────────────────────────

/// Builds the canonical full path: `"/" + prefix + path`. The
/// caller is responsible for ensuring `prefix` has no slashes
/// and `path` either starts with `/` or is bare.
pub fn build_full_path(prefix: &String, path: &String) -> String {
    if path.starts_with("/") {
        format!("/{prefix}{path}")
    } else {
        format!("/{prefix}/{path}")
    }
}

/// Returns true when `request_path` matches `route_path`
/// exactly or matches `route_path + "?..."` (the request also
/// carries a query string).
pub fn path_matches(request_path: &String, route_path: &String) -> bool {
    if *request_path == *route_path {
        return true
    }
    let with_query: String = route_path.clone() + "?"
    request_path.starts_with(&with_query)
}

// ─── Latency / randomness ──────────────────────────────────────

/// Advances an LCG state and returns the new state plus a
/// non-negative value. Embedded so the handler stays
/// self-sufficient under cross-module dispatch failures.
pub fn step_rng(state: i64) -> (i64, i64) {
    let new_state: i64 = state * 6_364_136_223_846_793_005 + 1_442_695_040_888_963_407
    let positive: i64 = if new_state < 0 { -new_state } else { new_state }
    let pair: (i64, i64) = (new_state, positive)
    pair
}

/// Picks a uniform-random latency in `[low_ms, high_ms]`.
/// Returns `(next_state, latency_ms)` so the caller can thread
/// the PRNG state across requests.
pub fn get_latency_ms(low_ms: i64, high_ms: i64, state: i64) -> (i64, i64) {
    if high_ms <= low_ms {
        let pair: (i64, i64) = (state, low_ms)
        return pair
    }
    let stepped = step_rng(state)
    let span: i64 = high_ms - low_ms + 1
    let pair: (i64, i64) = (stepped.0, low_ms + (stepped.1 % span))
    pair
}

// ─── Override / response body ──────────────────────────────────

/// Returns the override response body for `request_path`, or
/// `None` when no override is registered. `request_path` may
/// carry a `?query=` suffix.
pub fn lookup_override(responses: &json::Value, request_path: &String) -> Option<json::Value> {
    for entry in responses.iter() {
        let entry_path: String = entry.path
        if path_matches(request_path, &entry_path) {
            let body: json::Value = entry.body
            return Some(body)
        }
    }
    None
}

/// Builds the JSON body for a request: the override if one
/// matches, otherwise a default `{"message":"Response for
/// <path>"}` shape.
pub fn response_body_for(request_path: &String, responses: &json::Value) -> String {
    match lookup_override(responses, request_path) {
        Some(v) => json::render(&v),
        None => format!("{{\"message\":\"Response for {request_path}\"}}"),
    }
}

// ─── SSE / response shaping ────────────────────────────────────

/// Builds an SSE-formatted body wrapping `payload` as a single
/// `data:` chunk and ending with `data: [DONE]`. The Go
/// original streamed via `http.Flusher`; Gossamer's `std::http`
/// returns a single buffered response, so the body is one shot
/// but preserves the same wire format the original tests
/// asserted against.
pub fn build_sse_body(payload: &String) -> String {
    format!("data: {payload}\n\ndata: [DONE]\n\n")
}

/// Returns true when the request asked for SSE streaming via
/// `?stream=true`.
pub fn is_streaming_path(path: &String) -> bool {
    path.contains("stream=true")
}

/// Renders a JSON error body of the shape `{"error":"<msg>"}`.
pub fn error_body(msg: &str) -> String {
    format!("{{\"error\":\"{msg}\"}}")
}

/// Builds an `application/json` response from a status code and
/// body string.
pub fn json_response(status: i64, body: String) -> http::Response {
    http::Response::json(status as u16, body.into_bytes())
}

/// Builds a `text/event-stream` response by overwriting the
/// `Content-Type` header on a text response.
pub fn sse_response(status: i64, body: String) -> http::Response {
    let mut r = http::Response::text(status as u16, body)
    r.headers.insert("content-type", "text/event-stream")
    r
}

// ─── Routing ───────────────────────────────────────────────────

/// Result of matching a request against the registered spec
/// routes.
pub enum RouteMatch { NotFound, MethodNotAllowed, Found }

/// Matches `request_path` + `method_name` (uppercase, e.g.
/// `"GET"`) against the registered spec routes. The method is
/// passed by name so this stays bridge-independent — the
/// runtime's `match` over `http::Method` variants is not yet
/// wired in this Gossamer release.
pub fn match_route(
    spec_paths: &json::Value,
    prefix: &String,
    request_path: &String,
    method_name: &String,
) -> RouteMatch {
    let mut path_seen: bool = false
    for entry in spec_paths.iter() {
        let suffix: String = entry.path
        let full: String = build_full_path(prefix, &suffix)
        if path_matches(request_path, &full) {
            path_seen = true
            for m in entry.methods.iter() {
                let allowed: String = (*m).to_uppercase()
                if allowed == *method_name {
                    return RouteMatch::Found
                }
            }
        }
    }
    if path_seen { RouteMatch::MethodNotAllowed } else { RouteMatch::NotFound }
}

#[cfg(test)]
mod handler_tests {
    use std::encoding::json
    use std::http
    use std::testing

    fn parse(s: &str) -> json::Value {
        match json::parse(&s.to_string()) {
            Ok(v) => v,
            Err(_) => panic!("bad fixture json"),
        }
    }

    #[test]
    fn build_full_path_with_leading_slash() {
        testing::check_eq(
            &super::build_full_path(&"v1".to_string(), &"/foo".to_string()),
            &"/v1/foo".to_string(),
            "leading slash",
        )
    }

    #[test]
    fn build_full_path_without_leading_slash() {
        testing::check_eq(
            &super::build_full_path(&"v1".to_string(), &"foo".to_string()),
            &"/v1/foo".to_string(),
            "no leading slash",
        )
    }

    #[test]
    fn path_matches_exact() {
        testing::check(
            super::path_matches(&"/v1/test".to_string(), &"/v1/test".to_string()),
            "exact",
        )
    }

    #[test]
    fn path_matches_with_query() {
        testing::check(
            super::path_matches(&"/v1/test?stream=true".to_string(), &"/v1/test".to_string()),
            "with query",
        )
    }

    #[test]
    fn path_matches_misses_other_path() {
        testing::check(
            !super::path_matches(&"/v1/other".to_string(), &"/v1/test".to_string()),
            "miss",
        )
    }

    #[test]
    fn path_matches_does_not_match_extension() {
        testing::check(
            !super::path_matches(&"/v1/testing".to_string(), &"/v1/test".to_string()),
            "extension is not a match",
        )
    }

    #[test]
    fn lookup_override_finds_match() {
        let resp = parse("[{\"path\":\"/v1/test\",\"body\":{\"custom\":\"data\"}}]")
        let got = super::lookup_override(&resp, &"/v1/test".to_string())
        match got {
            Some(v) => testing::check(json::render(&v).contains("custom"), "renders body"),
            None => panic!("expected match"),
        }
    }

    #[test]
    fn lookup_override_misses_unknown() {
        let resp = parse("[{\"path\":\"/v1/test\",\"body\":\"x\"}]")
        let got = super::lookup_override(&resp, &"/v1/other".to_string())
        match got {
            Some(_) => panic!("expected none"),
            None => testing::check(true, "miss"),
        }
    }

    #[test]
    fn lookup_override_matches_with_query_string() {
        let resp = parse("[{\"path\":\"/v1/test\",\"body\":\"hi\"}]")
        let got = super::lookup_override(&resp, &"/v1/test?stream=true".to_string())
        match got {
            Some(_) => testing::check(true, "matched with query"),
            None => panic!("expected match"),
        }
    }

    #[test]
    fn response_body_for_uses_default_when_unmatched() {
        let resp = parse("[]")
        let body = super::response_body_for(&"/v1/unknown".to_string(), &resp)
        testing::check(body.contains("Response for /v1/unknown"), "default")
    }

    #[test]
    fn response_body_for_uses_override_when_matched() {
        let resp = parse("[{\"path\":\"/v1/foo\",\"body\":{\"k\":\"v\"}}]")
        let body = super::response_body_for(&"/v1/foo".to_string(), &resp)
        testing::check(body.contains("\"k\""), "override applied")
    }

    #[test]
    fn get_latency_ms_in_range() {
        let mut state: i64 = 1
        let mut i = 0
        while i < 200 {
            let pair = super::get_latency_ms(10, 20, state)
            state = pair.0
            testing::check(pair.1 >= 10, "lower")
            testing::check(pair.1 <= 20, "upper")
            i = i + 1
        }
    }

    #[test]
    fn get_latency_ms_collapses_when_high_le_low() {
        let pair = super::get_latency_ms(50, 50, 1)
        testing::check_eq(&pair.1, &50, "equal bounds")
        let pair2 = super::get_latency_ms(50, 30, pair.0)
        testing::check_eq(&pair2.1, &50, "inverted bounds")
    }

    #[test]
    fn build_sse_body_terminates_with_done() {
        let body = super::build_sse_body(&"hello world".to_string())
        testing::check(body.contains("[DONE]"), "termination marker")
        testing::check(body.contains("data: "), "data prefix")
    }

    #[test]
    fn is_streaming_path_detects_query() {
        testing::check(
            super::is_streaming_path(&"/v1/test?stream=true".to_string()),
            "stream flag",
        )
        testing::check(
            !super::is_streaming_path(&"/v1/test".to_string()),
            "no stream flag",
        )
    }

    #[test]
    fn error_body_renders_json() {
        testing::check_eq(
            &super::error_body("oops"),
            &"{\"error\":\"oops\"}".to_string(),
            "json error",
        )
    }

    #[test]
    fn match_route_finds_exact() {
        let spec = parse("{\"paths\":[{\"path\":\"/test\",\"methods\":[\"GET\"]}]}")
        let r = super::match_route(
            &spec.paths,
            &"v1".to_string(),
            &"/v1/test".to_string(),
            &"GET".to_string(),
        )
        match r {
            super::RouteMatch::Found => testing::check(true, "found"),
            super::RouteMatch::MethodNotAllowed => panic!("expected Found, got MethodNotAllowed"),
            super::RouteMatch::NotFound => panic!("expected Found, got NotFound"),
        }
    }

    #[test]
    fn match_route_method_not_allowed() {
        let spec = parse("{\"paths\":[{\"path\":\"/test\",\"methods\":[\"GET\"]}]}")
        let r = super::match_route(
            &spec.paths,
            &"v1".to_string(),
            &"/v1/test".to_string(),
            &"POST".to_string(),
        )
        match r {
            super::RouteMatch::MethodNotAllowed => testing::check(true, "405"),
            super::RouteMatch::Found => panic!("expected 405"),
            super::RouteMatch::NotFound => panic!("expected 405"),
        }
    }

    #[test]
    fn match_route_not_found() {
        let spec = parse("{\"paths\":[{\"path\":\"/test\",\"methods\":[\"GET\"]}]}")
        let r = super::match_route(
            &spec.paths,
            &"v1".to_string(),
            &"/v1/missing".to_string(),
            &"GET".to_string(),
        )
        match r {
            super::RouteMatch::NotFound => testing::check(true, "404"),
            super::RouteMatch::Found => panic!("expected 404"),
            super::RouteMatch::MethodNotAllowed => panic!("expected 404"),
        }
    }

    #[test]
    fn match_route_with_query_string() {
        let spec = parse("{\"paths\":[{\"path\":\"/test\",\"methods\":[\"GET\"]}]}")
        let r = super::match_route(
            &spec.paths,
            &"v1".to_string(),
            &"/v1/test?stream=true".to_string(),
            &"GET".to_string(),
        )
        match r {
            super::RouteMatch::Found => testing::check(true, "found with query"),
            super::RouteMatch::MethodNotAllowed => panic!("expected Found"),
            super::RouteMatch::NotFound => panic!("expected Found"),
        }
    }

    #[test]
    fn match_route_lowercase_methods_in_spec_get_uppercased() {
        let spec = parse("{\"paths\":[{\"path\":\"/test\",\"methods\":[\"get\"]}]}")
        let r = super::match_route(
            &spec.paths,
            &"v1".to_string(),
            &"/v1/test".to_string(),
            &"GET".to_string(),
        )
        match r {
            super::RouteMatch::Found => testing::check(true, "case-insensitive"),
            super::RouteMatch::MethodNotAllowed => panic!("expected Found"),
            super::RouteMatch::NotFound => panic!("expected Found"),
        }
    }
}
