use std::encoding::{json, yaml}
use std::{errors, fs}

/// Inclusive uniform-random response latency range, in milliseconds.
pub struct Latency { pub low: f64, pub high: f64 }

/// A JSON document in the two renderings the server writes, as the Go server
/// writes them: newline-terminated for a response body (`json.Encoder`),
/// bare for a simulated error and an SSE `data:` frame (`json.Marshal`).
pub struct JsonBody { pub line: String, pub compact: String }

/// Response returned when the error simulator fires, and how often it should.
pub struct ErrorResponse { pub code: i64, pub body: JsonBody, pub frequency: f64 }

/// Server configuration, read from YAML (JSON is accepted as a YAML subset).
pub struct Config {
    pub api_spec: String
    pub latency: Latency
    pub responses: Map<String, JsonBody>
    pub error_response: ErrorResponse
    pub prefix: String
}

/// Reads and validates the config file at `path`.
pub fn load_config(path: String) -> Result<Config, errors::Error> {
    let text = fs::read_to_string(path)
        .map_err(|e| errors::wrap(e, format("error reading config file {}", path)))?
    parse_config(text)
}

/// Parses config YAML, reporting every missing or invalid required value at once.
pub fn parse_config(text: String) -> Result<Config, errors::Error> {
    let json_text = yaml::to_json(text).map_err(|e| errors::wrap(e, "error parsing config file"))?
    let root = json::parse(json_text)?
    let mut missing = #[]
    let mut invalid = #[]

    let api_spec = present_string(root, "api_spec").unwrap_or("")
    if api_spec.is_empty() {
        missing.push("api_spec")
    }
    let low = number_at(root, "latency", "low", &mut missing, &mut invalid)
    let high = number_at(root, "latency", "high", &mut missing, &mut invalid)
    if let Some(l) = low && let Some(h) = high && (l < 0.0 || h < l) {
        invalid.push("latency.low and latency.high must satisfy 0 <= low <= high")
    }
    let frequency = number_at(root, "error_response", "frequency", &mut missing, &mut invalid)
    if let Some(f) = frequency && (f < 0.0 || f > 1.0) {
        invalid.push("error_response.frequency must be between 0 and 1")
    }
    let code = number_at(root, "error_response", "code", &mut missing, &mut invalid)
    if let Some(c) = code && (c < 100.0 || c > 599.0 || c != c.floor()) {
        invalid.push("error_response.code must be an HTTP status between 100 and 599")
    }
    let body = present(root, "error_response").and_then(|e| present(e, "body"))
    if body.is_none() {
        missing.push("error_response.body")
    }
    let prefix = present_string(root, "prefix").unwrap_or("")
    if prefix.is_empty() {
        missing.push("prefix")
    }
    let responses = parse_responses(root, &mut invalid)

    if missing.is_empty() && invalid.is_empty()
    && let Some(low) = low && let Some(high) = high && let Some(frequency) = frequency
    && let Some(code) = code && let Some(body) = body {
        return Ok(Config {
            api_spec: api_spec
            latency: Latency { low: low, high: high }
            responses: responses
            error_response: ErrorResponse {
                code: code as i64
                body: json_body(body)
                frequency: frequency
            }
            prefix: prefix
        })
    }
    Err(errors::new(describe_problems(missing, invalid)))
}

/// Renders `value` once in both forms a response needs.
pub fn json_body(value: json::Value) -> JsonBody {
    let compact = json::render(value)
    JsonBody { line: compact + "\n", compact: compact }
}

/// Normalized form of a route path: any trailing `/` removed.
pub fn normalize_path(path: String) -> String {
    let trimmed = path.trim_end_matches('/')
    if trimmed.is_empty() { "/" } else { trimmed }
}

// A field counts as present only when it exists and is not YAML `null`.
fn present(v: json::Value, key: String) -> Option<json::Value> {
    match json::get(v, key) {
        Some(field) => if json::is_null(field) { None } else { Some(field) }
        None => None
    }
}

fn present_string(v: json::Value, key: String) -> Option<String> {
    present(v, key).and_then(json::as_str).map(|s| s.trim())
}

// Records an absent or non-numeric field in `missing` or `invalid` and answers
// `None` for it.
fn number_at(
    root: json::Value
    section: String
    key: String
    missing: &mut Vec<String>
    invalid: &mut Vec<String>
) -> Option<f64> {
    let name = format("{}.{}", section, key)
    let Some(v) = present(root, section).and_then(|s| present(s, key)) else {
        missing.push(name)
        return None
    }
    let number = json::as_f64(v)
    if number.is_none() {
        invalid.push(format("{} must be a number", name))
    }
    number
}

// Accepts each override either as a structure or as a string of JSON text.
fn parse_responses(root: json::Value, invalid: &mut Vec<String>) -> Map<String, JsonBody> {
    let mut out = Map::new()
    let Some(responses) = present(root, "responses") else {
        return out
    }
    let Some(paths) = json::keys(responses) else {
        invalid.push("responses must map each path to a response body")
        return out
    }
    for path in paths {
        let Some(body) = json::get(responses, path) else { continue }
        let resolved = match json::as_str(body) {
            Some(text) => match json::parse(text) {
                Ok(parsed) => parsed
                Err(_) => {
                    invalid.push(format("responses.{} is a string but not valid JSON", path))
                    continue
                }
            }
            None => body
        }
        out.insert(normalize_path(path), json_body(resolved))
    }
    out
}

fn describe_problems(missing: Vec<String>, invalid: Vec<String>) -> String {
    let mut parts = #[]
    if !missing.is_empty() {
        parts.push(format("missing required configuration values: {}", missing.join(", ")))
    }
    if !invalid.is_empty() {
        parts.push(format("invalid configuration values: {}", invalid.join("; ")))
    }
    parts.join("; ")
}

#[cfg(test)]
mod tests {
    use std::{errors, fs}

    use super::{load_config, normalize_path, parse_config}

    const VALID: String = """
    api_spec: "spec.yaml"
    latency:
      low: 100
      high: 1000
    responses:
      /v1/test: '{"message":"override"}'
      /v1/struct/:
        status: success
        code: 200
    error_response:
      code: 500
      body:
        error: "simulated error"
      frequency: 0.05
    prefix: "v1"
    """

    const ALL_REQUIRED: [String; 7] = [
        "api_spec"
        "latency.low"
        "latency.high"
        "error_response.frequency"
        "error_response.code"
        "error_response.body"
        "prefix"
    ]

    fn error_of(text: String) -> String {
        match parse_config(text) {
            Ok(_) => panic("expected a config error")
            Err(e) => e.to_string()
        }
    }

    #[test]
    fn parses_a_valid_config() -> Result<(), errors::Error> {
        let cfg = parse_config(VALID)?
        assert_eq(cfg.api_spec, "spec.yaml")
        assert_eq(cfg.latency.low, 100.0)
        assert_eq(cfg.latency.high, 1000.0)
        assert_eq(cfg.error_response.code, 500)
        assert_eq(cfg.error_response.frequency, 0.05)
        assert_eq(cfg.prefix, "v1")
        assert_eq(cfg.error_response.body.compact, "{\"error\":\"simulated error\"}")
        assert_eq(cfg.error_response.body.line, "{\"error\":\"simulated error\"}\n")
        Ok(())
    }

    #[test]
    fn string_overrides_are_decoded_as_json() -> Result<(), errors::Error> {
        let cfg = parse_config(VALID)?
        assert_eq(cfg.responses.get("/v1/test").map(|b| b.compact), Some("{\"message\":\"override\"}"))
        Ok(())
    }

    #[test]
    fn structured_overrides_are_kept_and_paths_normalized() -> Result<(), errors::Error> {
        let cfg = parse_config(VALID)?
        let compact = cfg.responses.get("/v1/struct").map(|b| b.compact)
        assert_eq(compact, Some("{\"code\":200,\"status\":\"success\"}"))
        Ok(())
    }

    #[test]
    fn responses_are_optional() -> Result<(), errors::Error> {
        let cfg = parse_config("""
        api_spec: spec.yaml
        latency: { low: 1, high: 2 }
        error_response: { code: 503, body: { error: x }, frequency: 0 }
        prefix: v1
        """)?
        assert(cfg.responses.is_empty())
        assert_eq(cfg.error_response.frequency, 0.0)
        Ok(())
    }

    #[test]
    fn reports_every_missing_value() {
        let msg = error_of("""
        api_spec: ""
        error_response:
          body: null
        prefix: ""
        """)
        assert(msg.contains("missing required configuration values"), msg)
        for field in ALL_REQUIRED {
            assert(msg.contains(field), format("{} not reported in: {}", field, msg))
        }
    }

    #[test]
    fn reports_only_the_missing_subset() {
        let msg = error_of("""
        api_spec: "spec.yaml"
        latency:
          low: 10
        error_response:
          code: 500
          frequency: 0.1
        """)
        assert(msg.contains("latency.high"), msg)
        assert(msg.contains("error_response.body"), msg)
        assert(msg.contains("prefix"), msg)
        assert(!msg.contains("api_spec"), msg)
        assert(!msg.contains("latency.low"), msg)
        assert(!msg.contains("error_response.code"), msg)
    }

    #[test]
    fn rejects_out_of_range_values() {
        let msg = error_of("""
        api_spec: spec.yaml
        latency: { low: 500, high: 100 }
        error_response: { code: 42, body: { error: x }, frequency: 1.5 }
        prefix: v1
        """)
        assert(msg.contains("invalid configuration values"), msg)
        assert(msg.contains("latency.low and latency.high"), msg)
        assert(msg.contains("error_response.frequency must be between 0 and 1"), msg)
        assert(msg.contains("error_response.code must be an HTTP status"), msg)
    }

    #[test]
    fn rejects_non_numeric_values() {
        let msg = error_of("""
        api_spec: spec.yaml
        latency: { low: fast, high: 100 }
        error_response: { code: 500, body: { error: x }, frequency: 0.1 }
        prefix: v1
        """)
        assert(msg.contains("latency.low must be a number"), msg)
    }

    #[test]
    fn rejects_an_override_string_that_is_not_json() {
        let msg = error_of("""
        api_spec: spec.yaml
        latency: { low: 1, high: 2 }
        responses:
          /v1/bad: "{not json"
        error_response: { code: 500, body: { error: x }, frequency: 0.1 }
        prefix: v1
        """)
        assert(msg.contains("responses./v1/bad is a string but not valid JSON"), msg)
    }

    #[test]
    fn rejects_invalid_yaml() {
        let msg = error_of("invalid: yaml: -")
        assert(msg.contains("error parsing config file"), msg)
    }

    #[test]
    fn load_config_reads_a_file() -> Result<(), errors::Error> {
        let dir = fs::temp_dir("mock-api-config")?
        defer fs::remove_dir_all(dir)
        let path = format("{}/config.yaml", dir)
        fs::write(path, VALID.as_bytes())?
        let cfg = load_config(path)?
        assert_eq(cfg.api_spec, "spec.yaml")
        Ok(())
    }

    #[test]
    fn load_config_reports_a_missing_file() {
        match load_config("non_existent_config.yaml") {
            Ok(_) => panic("expected a read error")
            Err(e) => assert(e.to_string().contains("error reading config file"), e.to_string())
        }
    }

    #[test]
    fn normalize_path_trims_trailing_slashes() {
        assert_eq(normalize_path("/v1/models/"), "/v1/models")
        assert_eq(normalize_path("/v1/models"), "/v1/models")
        assert_eq(normalize_path("/"), "/")
    }
}
