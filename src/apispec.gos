use std::encoding::{json, yaml}
use std::{errors, fs, http}

// The operation keys an OpenAPI path item may carry; every other key
// (`summary`, `parameters`, `servers`, ...) describes the path, not a method.
const OPERATIONS: [String; 8] = ["get", "put", "post", "delete", "options", "head", "patch", "trace"]

/// One spec path and the HTTP methods (upper case) it declares.
pub struct PathItem { pub path: String, pub methods: Vec<String> }

/// The routable part of an OpenAPI document: its paths, sorted.
pub struct ApiSpec { pub paths: Vec<PathItem> }

/// Loads the spec from an `http(s)://` URL or a file path.
pub fn load_api_spec(location: String) -> Result<ApiSpec, errors::Error> {
    let text = if location.starts_with("http://") || location.starts_with("https://") {
        fetch(location)?
    } else {
        fs::read_to_string(location)
            .map_err(|e| errors::wrap(e, format("error reading API spec file {}", location)))?
    }
    parse_api_spec(text)
}

/// Parses OpenAPI YAML (or JSON) into its routable paths.
pub fn parse_api_spec(text: String) -> Result<ApiSpec, errors::Error> {
    let root = yaml::parse(text).map_err(|e| errors::wrap(e, "error parsing API spec"))?
    let Some(paths) = json::get(root, "paths") else {
        return Err(errors::new("error parsing API spec: missing `paths`"))
    }
    let Some(keys) = json::keys(paths) else {
        return Err(errors::new("error parsing API spec: `paths` must be a mapping"))
    }
    let mut items = #[]
    for path in keys {
        let declared = json::get(paths, path).and_then(json::keys).unwrap_or(#[])
        let methods = OPERATIONS
            .to_vec()
            .filter(|op| declared.contains(op))
            .map(|op| op.to_uppercase())
        items.push(PathItem { path: path, methods: methods })
    }
    items.sort_by_key(|p| p.path)
    Ok(ApiSpec { paths: items })
}

fn fetch(url: String) -> Result<String, errors::Error> {
    let resp = http::get(url, #[])
        .map_err(|e| errors::wrap(e, format("error fetching API spec from URL {}", url)))?
    if resp.status < 200 || resp.status > 299 {
        return Err(errors::new(format("error fetching API spec from URL {}: status {}", url, resp.status)))
    }
    Ok(resp.body)
}

#[cfg(test)]
mod tests {
    use std::{errors, fs}

    use super::{load_api_spec, parse_api_spec}

    #[test]
    fn parses_paths_and_methods() -> Result<(), errors::Error> {
        let spec = parse_api_spec("""
        paths:
          /test:
            get: {}
          /models/{model}:
            parameters: []
            summary: one model
            get: {}
            delete: {}
        """)?
        assert_eq(spec.paths.len(), 2)
        assert_eq(spec.paths[0].path, "/models/{model}")
        assert_eq(spec.paths[0].methods, #["GET", "DELETE"])
        assert_eq(spec.paths[1].path, "/test")
        assert_eq(spec.paths[1].methods, #["GET"])
        Ok(())
    }

    #[test]
    fn accepts_json_specs() -> Result<(), errors::Error> {
        let spec = parse_api_spec("{\"paths\": {\"/x\": {\"post\": {}}}}")?
        assert_eq(spec.paths[0].methods, #["POST"])
        Ok(())
    }

    #[test]
    fn rejects_a_spec_without_paths() {
        match parse_api_spec("openapi: 3.0.0") {
            Ok(_) => panic("expected an error")
            Err(e) => assert(e.to_string().contains("missing `paths`"), e.to_string())
        }
    }

    #[test]
    fn rejects_invalid_yaml() {
        match parse_api_spec("invalid: yaml: -") {
            Ok(_) => panic("expected an error")
            Err(e) => assert(e.to_string().contains("error parsing API spec"), e.to_string())
        }
    }

    #[test]
    fn load_api_spec_reads_a_file() -> Result<(), errors::Error> {
        let dir = fs::temp_dir("mock-api-spec")?
        defer fs::remove_dir_all(dir)
        let path = format("{}/spec.yaml", dir)
        fs::write(path, "paths:\n  /test:\n    get: {}\n".as_bytes())?
        assert_eq(load_api_spec(path)?.paths.len(), 1)
        Ok(())
    }

    #[test]
    fn load_api_spec_reports_a_missing_file() {
        match load_api_spec("non_existent_file.yaml") {
            Ok(_) => panic("expected an error")
            Err(e) => assert(e.to_string().contains("error reading API spec file"), e.to_string())
        }
    }

    #[test]
    fn load_api_spec_reports_an_unreachable_url() {
        match load_api_spec("http://127.0.0.1:1/spec.yaml") {
            Ok(_) => panic("expected an error")
            Err(e) => assert(e.to_string().contains("error fetching API spec from URL"), e.to_string())
        }
    }
}
