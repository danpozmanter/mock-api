use std::{env, errors, flag, http, time}

use apispec::load_api_spec
use config::load_config
use handler::{serve, App}
use random::Random

fn main() -> Result<(), errors::Error> {
    let mut flags = flag::Set::new("mock-api")
    let config_path = flags.string("config", "config.yaml", "path to the config file")
    let port = flags.string("port", "8080", "port to listen on")
    let _ = flags.parse(env::args())?

    let app = initialize(*config_path).map_err(|e| errors::wrap(e, "Failed to initialize server"))?

    let server = http::Server::new()
    server.listen(format("0.0.0.0:{}", *port))?
    println("Starting server on {}", server.addr())
    serve(app, server)
}

/// Loads the config and the spec it names, and registers every route.
fn initialize(config_path: String) -> Result<App, errors::Error> {
    let cfg = load_config(config_path)?
    println(
        "Loaded config: api_spec={} prefix={} latency={}-{} ms error_response={} at frequency {}"
        cfg.api_spec
        cfg.prefix
        cfg.latency.low
        cfg.latency.high
        cfg.error_response.code
        cfg.error_response.frequency
    )
    let spec = load_api_spec(cfg.api_spec)?
    println("Loaded API spec with {} paths", spec.paths.len())
    let overrides = cfg.responses.keys()
    let app = App::new(cfg, spec, Random::seeded(time::now_ms()))?
    for (method, path) in app.endpoints() {
        println("Registered endpoint: {} {}", method, path)
    }
    println("Loaded responses: {}", overrides.join(", "))
    Ok(app)
}
