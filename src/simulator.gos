use std::sync

use random::Random

/// Adaptive error source for one route path. Copies share its counters and
/// generator, so one simulator serves every concurrent request to that path.
pub struct ErrorSimulator {
    target_frequency: f64
    total_requests: sync::AtomicU64
    total_errors: sync::AtomicU64
    rng: Random
}

impl ErrorSimulator {
    /// Simulator aiming for `frequency` (0.0 never, 1.0 always) errors per request.
    pub fn new(frequency: f64, rng: Random) -> ErrorSimulator {
        ErrorSimulator {
            target_frequency: frequency
            total_requests: sync::AtomicU64::new(0)
            total_errors: sync::AtomicU64::new(0)
            rng: rng
        }
    }

    /// Decides whether the current request fails, raising the odds by half while
    /// the observed rate trails the target and halving them while it leads.
    pub fn should_error(&self) -> bool {
        let requests = self.total_requests.fetch_add(1) + 1
        let current_rate = self.total_errors.load() as f64 / requests as f64
        let target = self.target_frequency
        let adjusted = if current_rate < target {
            target * 1.5
        } else if current_rate > target {
            target * 0.5
        } else {
            target
        }
        let fired = self.rng.next_f64() < adjusted
        if fired {
            self.total_errors.fetch_add(1)
        }
        fired
    }

    /// Observed error proportion so far; 0.0 before the first request.
    pub fn current_error_rate(&self) -> f64 {
        let requests = self.total_requests.load()
        if requests == 0 {
            return 0.0
        }
        self.total_errors.load() as f64 / requests as f64
    }
}

#[cfg(test)]
mod tests {
    use std::math
    use std::sync

    use random::Random

    use super::ErrorSimulator

    fn with_history(frequency: f64, requests: i64, errors: i64) -> ErrorSimulator {
        ErrorSimulator {
            target_frequency: frequency
            total_requests: sync::AtomicU64::new(requests)
            total_errors: sync::AtomicU64::new(errors)
            rng: Random::seeded(1234)
        }
    }

    fn observed_rate(frequency: f64, iterations: i64) -> f64 {
        let sim = ErrorSimulator::new(frequency, Random::seeded(99))
        let mut errors = 0
        for _ in 0..iterations {
            if sim.should_error() {
                errors += 1
            }
        }
        errors as f64 / iterations as f64
    }

    #[test]
    fn current_error_rate_reports_the_observed_ratio() {
        assert_eq(with_history(0.5, 0, 0).current_error_rate(), 0.0)
        assert_eq(with_history(0.5, 100, 0).current_error_rate(), 0.0)
        assert_eq(with_history(0.5, 100, 100).current_error_rate(), 1.0)
        assert_eq(with_history(0.5, 100, 50).current_error_rate(), 0.5)
    }

    #[test]
    fn should_error_converges_to_the_target() {
        for target in [0.0, 0.25, 0.5, 0.75, 1.0] {
            let actual = observed_rate(target, 1000)
            let diff = math::abs(actual - target)
            assert(diff <= 0.05, format("target {} observed {}", target, actual))
        }
    }

    #[test]
    fn should_error_raises_odds_below_target() {
        let sim = with_history(0.5, 100, 25)
        let mut errors = 0
        for _ in 0..100 {
            if sim.should_error() {
                errors += 1
            }
        }
        assert(errors > 50, format("expected more than 50 errors, got {}", errors))
    }

    #[test]
    fn should_error_lowers_odds_above_target() {
        let sim = with_history(0.5, 100, 75)
        let mut errors = 0
        for _ in 0..100 {
            if sim.should_error() {
                errors += 1
            }
        }
        assert(errors < 50, format("expected fewer than 50 errors, got {}", errors))
    }

    #[test]
    fn concurrent_callers_count_every_request() {
        let sim = ErrorSimulator::new(0.5, Random::seeded(5))
        let workers = 10
        let iterations = 1000
        let outcome = cohort {
            for _ in 0..workers {
                spawn(|| {
                    for _ in 0..iterations {
                        let _ = sim.should_error()
                        let _ = sim.current_error_rate()
                    }
                })
            }
        }
        assert(outcome.is_ok())
        assert_eq(sim.total_requests.load(), workers * iterations)
    }
}
